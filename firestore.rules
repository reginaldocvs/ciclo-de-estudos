rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Contas que podem sincronizar. Para liberar outra pessoa, acrescente o UID dela
    // (Authentication → Usuários). Para abrir a todos, apague a linha "&& permitido()".
    function permitido() {
      return request.auth.uid in ['COGDlcfi9qdxy6ifXOrQJr5VdBX2'];
    }
    // Cada pessoa só lê e grava os próprios dados (users/{uid}/ciclo/...)
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && permitido();
    }
  }
}
